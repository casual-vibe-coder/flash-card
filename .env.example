# .env.example — Environment variables for the Arabic Flashcard App.
#
# Copy this file to ".env" (local) or set these in Vercel → Project → Settings →
# Environment Variables. NEVER commit your real .env file to git.
#
# ─── Required for the core "hide keys + $7 cap" milestone ───

# OpenRouter API key — the main AI provider for all text generation.
# Must be a SimplifAI-owned key, NOT a personal key.
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase service account JSON — the full contents of the private key file.
# Generate one at: Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" → copy the entire JSON here.
# This enables: server-side auth verification, $7 cap enforcement, usage logging.
# Format: paste the raw JSON on one line (or escape newlines).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"flash-card",...}

# Admin email allowlist — comma-separated, no spaces needed.
# These users bypass the $7 cap. They can also edit other users' caps
# by changing `settings.usageCap` in their Firestore user doc manually.
ADMINS=mdrahman.bfd@gmail.com,developer.shourav1@gmail.com

# ─── Optional: model overrides (hardcoded defaults used if not set) ───
# These let you swap the model behind a quality tier without a code redeploy.

# Normal tier (default: openai/gpt-4o-mini — cheap & fast)
MODEL_NORMAL=openai/gpt-4o-mini

# High tier (default: google/gemini-flash-1.5 — balanced)
MODEL_HIGH=google/gemini-flash-1.5

# Extra High tier (default: openai/gpt-4o — best quality, most expensive)
MODEL_EXTRAHIGH=openai/gpt-4o

# ─── Optional: other AI provider keys (for image/TTS/STT features) ───
# Without these, the respective features gracefully fall back to browser
# alternatives (browser TTS, browser speech recognition, no image gen).

# Google AI Studio key — for Gemini "Nano Banana" image generation on flashcards.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud Text-to-Speech key — for Arabic Wavenet voices (better tashkeel).
# Can be the same as GOOGLE_API_KEY if Cloud TTS is enabled on the same project.
# Get one at: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_TTS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key — for Whisper speech-to-text (Enhanced STT for Arabic).
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deepgram API key — alternative STT provider (optional, overrides Whisper if set).
# Get one at: https://console.deepgram.com/
# DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx